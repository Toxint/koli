generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ── Enums ──────────────────────────────────────────────

enum UserRole {
  CLIENT
  SELLER
  DRIVER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SellerVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OrderStatus {
  DRAFT
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  FUNDS_SECURED
  SELLER_ACCEPTED
  PACKAGE_PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  IN_TRANSIT
  ARRIVED
  DELIVERED
  CUSTOMER_CONFIRMED
  FUNDS_RELEASED
  COMPLETED
  CANCELLED
  PAYMENT_FAILED
  DELIVERY_FAILED
  DISPUTE_OPEN
  REFUND_PENDING
  REFUNDED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  /** Intention creee, rien n a encore ete demande au payeur. */
  PENDING

  /**
   * Le payeur doit valider sur son telephone (code USSD ou notification).
   *
   * Cet etat MANQUAIT, et c est le plus long de tous en Mobile Money : il dure
   * de quelques secondes a plusieurs minutes. Sans lui, l ecran ne pouvait
   * dire que « en attente », sans preciser que la balle est dans le camp du
   * client — qui attendait donc que KOLI fasse quelque chose.
   */
  AWAITING_CUSTOMER

  SUCCEEDED
  FAILED

  /**
   * La fenetre de validation s est refermee sans reponse.
   *
   * Distinct de FAILED : rien n a ete refuse, personne n a rien decide. Le
   * client peut simplement recommencer, et le message doit le dire.
   */
  EXPIRED
}

enum PaymentProviderType {
  TEST
}

enum TransactionType {
  PAYMENT
  COMMISSION
  FUNDS_SECURED
  FUNDS_RELEASED
  REFUND
}

enum DeliveryStatus {
  // Commande creee, aucun livreur encore designe. L'enum n'avait pas cet etat :
  // une livraison sans livreur etait marquee ASSIGNED, ce qui est faux (§26 —
  // l'assignation est un acte explicite du vendeur).
  UNASSIGNED
  ASSIGNED
  TO_PICK_UP
  PICKED_UP
  IN_TRANSIT
  ARRIVED
  TO_CONFIRM
  CONFIRMED
  FAILED
}

enum DisputeReason {
  NOT_RECEIVED
  WRONG_PRODUCT
  DAMAGED
  INCOMPLETE
  NOT_AS_DESCRIBED
  OTHER
}

enum DisputeStatus {
  OPEN
  ADMIN_REVIEW
  SELLER_WINS
  CUSTOMER_WINS
}

enum RefundStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum NotificationType {
  PAYMENT_CONFIRMED
  FUNDS_SECURED
  ORDER_ACCEPTED
  PACKAGE_READY
  PICKED_UP
  IN_TRANSIT
  // Le livreur est devant la porte. C est le moment ou le client doit AGIR :
  // sortir son code de reception. Sans type dedie, cet avis se serait confondu
  // avec « en route », qui n appelle aucun geste.
  ARRIVED
  DELIVERED
  CUSTOMER_CONFIRMED
  FUNDS_RELEASED
  DISPUTE_OPEN
  REFUND
}

// ── Identité ────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  role         UserRole
  name         String
  phone        String     @unique
  email        String?    @unique
  // Nullable : un compte cree via Google n'a pas de mot de passe. Le laisser
  // obligatoire aurait force a stocker un faux hachage, indistinguable d'un
  // vrai mot de passe pour le reste du code.
  passwordHash String?
  photoUrl     String?

  // Identifiant Google stable (claim `sub`). C'est LUI qui lie le compte, et
  // non l'e-mail : une adresse peut changer de proprietaire, `sub` non.
  googleId     String?     @unique
  status       UserStatus @default(ACTIVE)

  // Limitation des tentatives de connexion (§47). La contrainte existait pour
  // l'OTP mais pas pour le mot de passe : le compte acceptait un nombre
  // illimite d'essais.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Reinitialisation du mot de passe (§62). On stocke le HACHAGE du jeton, pas
  // le jeton : une fuite de la base ne doit pas permettre de prendre la main
  // sur les comptes dont une demande est en cours.
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sellerProfile   SellerProfile?
  customerProfile CustomerProfile?
  driverProfile   DriverProfile?
  notifications   Notification[]
  auditLogs       AuditLog[]       @relation("AuditActor")
  kycRevues       KycDocument[]    @relation("KycReviewer")
  historiques     OrderStatusHistory[] @relation("HistoriqueActeur")
  messagesLitige  DisputeMessage[]     @relation("MessageAuteur")
}

model SellerProfile {
  id                     String                   @id @default(cuid())
  userId                 String                   @unique
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName           String?
  verificationStatus     SellerVerificationStatus @default(PENDING)
  commissionRateOverride Float?

  // §37 : « Prevoir : identite, telephone, documents, statut. »
  //
  // Le nom LEGAL, tel qu il figure sur la piece — souvent different de
  // l enseigne commerciale. Sans lui, l administration compare le document a
  // un nom de boutique, ce qui ne prouve rien.
  //
  // Le telephone n est pas redouble ici : il vit deja sur le compte, et une
  // seconde copie divergerait a la premiere mise a jour.
  legalName              String?
  kycSubmittedAt         DateTime?

  createdAt              DateTime                 @default(now())

  products Product[]
  orders   Order[]
  kyc      KycDocument[]
  funds    Fund[]
}

model CustomerProfile {
  id      String  @id @default(cuid())
  userId  String  @unique
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  address String?
  city    String?
  country String?

  orders Order[]
}

model DriverProfile {
  id      String  @id @default(cuid())
  userId  String  @unique
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle String?

  deliveries Delivery[]
}

// ── Catalogue ───────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  category    String?
  price       Int      // FCFA — entier, pas de centimes
  quantity    Int      @default(0)
  weightKg    Float?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())

  images     ProductImage[]
  orderItems OrderItem[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int     @default(0)
}

// ── Commandes ───────────────────────────────────────────

model Order {
  id         String   @id @default(cuid())
  reference  String   @unique // "KOLI-000124"
  sellerId   String
  seller     SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  customerId String?
  customer   CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  buyerName     String
  buyerPhone    String
  // Etape 2 du formulaire de commande : e-mail facultatif du client. Servira a
  // lui transmettre la facture ; le telephone reste l'identifiant, l'e-mail
  // n'etant pas repandu dans le public vise.
  buyerEmail    String?
  buyerCountry  String
  buyerCity     String
  buyerAddress  String
  buyerLandmark String?

  deliveryFee Int         @default(0)
  // Zone monetaire de la commande : "XOF" (UEMOA) ou "XAF" (CEMAC, dont le
  // Cameroun). Les deux s'affichent « FCFA » mais ne sont pas interchangeables ;
  // sans ce champ, toute commande camerounaise etait traitee comme XOF.
  currency    String      @default("XOF")
  status      OrderStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  payment       Payment?
  delivery      Delivery?
  dispute       Dispute?
  refund        Refund?
  transactions  Transaction[]
  invoice       Invoice?
  statusHistory OrderStatusHistory[]
  fund          Fund?
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  unitPrice Int
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  /**
   * Qui a provoque le changement d etat.
   *
   * `SetNull` et non `Cascade` : supprimer un compte ne doit pas effacer
   * l historique d une commande. La ligne reste, elle perd seulement son
   * auteur — un trou dans l attribution vaut mieux qu un trou dans le
   * deroule des faits.
   *
   * Nul aussi quand l acte n a pas d auteur humain : un paiement aboutit sans
   * que personne ne clique cote KOLI.
   */
  actorUserId String?
  actor       User?        @relation("HistoriqueActeur", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt   DateTime     @default(now())

  @@index([orderId, createdAt])
}

// ── Paiement / argent (mode test) ──────────────────────

model Payment {
  id               String              @id @default(cuid())
  orderId          String              @unique
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider         PaymentProviderType @default(TEST)
  status           PaymentStatus       @default(PENDING)
  amount           Int
  simulatedOutcome String?             // "SUCCESS" | "FAILURE", mode test uniquement

  /**
   * Reference de la transaction CHEZ LE FOURNISSEUR.
   *
   * Elle etait produite par l abstraction et jetee aussitot : rien ne la
   * stockait. Un rappel asynchrone du prestataire — le mode normal en Mobile
   * Money — n avait donc aucun moyen de retrouver le paiement concerne.
   *
   * Unique : deux paiements ne peuvent pas revendiquer la meme transaction.
   */
  providerRef      String?             @unique

  /**
   * Clef d idempotence envoyee AU fournisseur.
   *
   * Les agregateurs l exigent : sans elle, un renvoi de requete apres une
   * coupure reseau cree un SECOND prelevement. Elle est fixee a la creation de
   * l intention et ne change jamais, meme sur reessai.
   */
  idempotencyKey   String?             @unique

  // Qui a paye, et depuis quel operateur. Necessaire au rapprochement et au
  // support : « je vous ai envoye l argent » se verifie avec ces deux champs.
  payerMsisdn      String?
  payerOperator    String?

  /** Motif d echec en clair, pour l afficher au client sans le traduire. */
  failureReason    String?

  /**
   * Fin de la fenetre de validation. Au-dela, le paiement est EXPIRED.
   *
   * Sans echeance, un paiement jamais valide resterait « en attente » a vie et
   * immobiliserait la commande.
   */
  expiresAt        DateTime?

  /** Dernier rapprochement. Voir lib/payments/rapprochement.ts. */
  lastCheckedAt    DateTime?

  createdAt        DateTime            @default(now())
  confirmedAt      DateTime?

  @@index([status, expiresAt])
  @@index([status, lastCheckedAt])
}

model Transaction {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      TransactionType
  amount    Int             // signé : + crédit / - débit
  createdAt DateTime        @default(now())

  // Taux appliqué, figé au moment de l'écriture (§41). Ne concerne que les
  // lignes COMMISSION ; ailleurs il reste nul.
  //
  // Il est stocké et non relu depuis `Commission` : le taux est configurable,
  // donc il change. Le relire aujourd'hui pour expliquer une écriture d'il y a
  // trois mois réécrirait le passé — un journal comptable ne se relit pas à la
  // lumière des réglages du jour.
  rate      Float?

  @@index([orderId])
  @@index([type, createdAt])
}

model Fund {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /**
   * Vendeur bénéficiaire.
   *
   * C'était le SEUL lien du schéma sans clé étrangère : `sellerId` n'était
   * qu'une chaîne. Rien n'empêchait donc d'y écrire un identifiant qui
   * n'existe pas — et le séquestre correspondant serait devenu invisible dans
   * le solde du vendeur, sans qu'aucune erreur ne le signale. Sur un registre
   * qui dit combien la plateforme doit à qui, c'est le genre d'écart qu'on ne
   * découvre qu'au moment de payer.
   *
   * `Cascade` par cohérence avec `Order.sellerId`, déjà en cascade : supprimer
   * un vendeur supprime déjà ses commandes, donc ses fonds par `orderId`. Un
   * autre choix ici produirait deux comportements contradictoires selon le
   * chemin de suppression.
   */
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  amount     Int
  secured    Boolean   @default(false)
  released   Boolean   @default(false)
  securedAt  DateTime?
  releasedAt DateTime?

  // Le solde vendeur agrège sur ces trois colonnes à chaque affichage.
  @@index([sellerId, secured, released])
}

model Refund {
  id          String       @id @default(cuid())
  orderId     String       @unique
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Int
  status      RefundStatus @default(PENDING)
  reason      String?
  createdAt   DateTime     @default(now())
  processedAt DateTime?
}

model Invoice {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  number    String   @unique
  createdAt DateTime @default(now())
}

model Commission {
  id          String   @id @default(cuid())
  ratePercent Float    @default(5)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ── Livraison ───────────────────────────────────────────

model Delivery {
  id          String         @id @default(cuid())
  orderId     String         @unique
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverId    String?
  driver      DriverProfile? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  status      DeliveryStatus @default(ASSIGNED)
  assignedAt  DateTime       @default(now())
  pickedUpAt  DateTime?
  arrivedAt   DateTime?
  deliveredAt DateTime?

  proof    DeliveryProof?
  otpCodes OtpCode[]
}

model DeliveryProof {
  id           String   @id @default(cuid())
  deliveryId   String   @unique
  delivery     Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  otpCode      String
  confirmedAt  DateTime @default(now())
  signatureUrl String?
  photoUrl     String?
  latitude     Float?
  longitude    Float?
}

model OtpCode {
  id          String    @id @default(cuid())
  deliveryId  String
  delivery    Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  code        String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
}

// ── Litiges ─────────────────────────────────────────────

model Dispute {
  id          String        @id @default(cuid())
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason      DisputeReason
  description String?
  status      DisputeStatus @default(OPEN)
  decision    String?
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?

  messages DisputeMessage[]
}

model DisputeMessage {
  id            String   @id @default(cuid())
  disputeId     String
  dispute       Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  /**
   * Auteur du message — client, vendeur ou administration.
   *
   * `Cascade` : les messages d un compte supprime partent avec lui. Un fil de
   * litige n a pas vocation a conserver les propos de quelqu un qui n existe
   * plus, et la decision, elle, reste au journal d audit.
   */
  authorUserId  String
  author        User     @relation("MessageAuteur", fields: [authorUserId], references: [id], onDelete: Cascade)

  body          String?
  attachmentUrl String?
  createdAt     DateTime @default(now())

  @@index([disputeId, createdAt])
}

// ── Notifications / audit / conformité ─────────────────

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  readAt     DateTime?
  entityType String?
  entityId   String?
  createdAt  DateTime         @default(now())

  // Le compteur de non-lues est lu à chaque affichage de page, sur toutes les
  // pages de l'espace connecté : sans index, c'est un balayage complet de la
  // table à chaque navigation.
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String   // ex. "FUNDS_RELEASE_TEST"
  entityType  String
  entityId    String
  metadata    String?  // JSON sérialisé

  // Copie du nom et du rôle de l'acteur au moment des faits.
  //
  // `actorUserId` est en `SetNull` : supprimer un compte ne doit pas effacer
  // ce qu'il a fait. Mais le lien se perd alors, et la ligne devient anonyme —
  // un journal qui ne peut plus nommer l'auteur d'une décision ne remplit plus
  // sa fonction. Ces deux champs, eux, survivent à la suppression du compte.
  actorName   String?
  actorRole   String?

  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([action])
}

model KycDocument {
  id       String        @id @default(cuid())
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type     String

  /**
   * Emplacement du fichier dans le magasin, JAMAIS une adresse publique.
   *
   * Une pièce d'identité déposée sous `/public` serait lisible par quiconque
   * devine son nom — et rien n'avertirait. Le fichier est écrit hors de
   * l'arborescence servie, et seul `/api/kyc/<id>` le restitue, après contrôle
   * du demandeur.
   */
  fileUrl  String

  /** Nom d'origine, pour l'affichage seulement — jamais pour écrire sur disque. */
  originalName String?
  /** Type déterminé par LECTURE du fichier, pas d'après ce que le client annonce. */
  mimeType     String?
  sizeBytes    Int?

  status KycStatus @default(PENDING)

  // Qui a décidé, quand, et pourquoi en cas de refus. Un rejet sans motif
  // laisse le vendeur sans rien à corriger.
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?     @relation("KycReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectionReason String?

  createdAt DateTime @default(now())

  @@index([sellerId, status])
  @@index([status, createdAt])
}

model Setting {
  key   String @id
  value String // JSON sérialisé
}
