generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres, fourni par Supabase.
  //
  // Le passage depuis SQLite n est pas un simple changement de mot : les
  // migrations SQLite ne s appliquent pas a Postgres (types, contraintes et
  // syntaxe different). Elles ont donc ete regenerees a partir du modele, dans
  // prisma/migrations-postgres/.
  //
  // Consequence a connaitre : les enumerations deviennent de VRAIS types
  // Postgres. Ajouter une valeur exige desormais une migration, la ou SQLite
  // les stockait en texte et acceptait n importe quoi.
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────

enum UserRole {
  CLIENT
  SELLER
  DRIVER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SellerVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OrderStatus {
  DRAFT
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  FUNDS_SECURED
  SELLER_ACCEPTED
  PACKAGE_PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  IN_TRANSIT
  ARRIVED
  DELIVERED
  CUSTOMER_CONFIRMED
  FUNDS_RELEASED
  COMPLETED
  CANCELLED
  PAYMENT_FAILED
  DELIVERY_FAILED
  DISPUTE_OPEN
  REFUND_PENDING
  REFUNDED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  /** Intention creee, rien n a encore ete demande au payeur. */
  PENDING

  /**
   * Le payeur doit valider sur son telephone (code USSD ou notification).
   *
   * Cet etat MANQUAIT, et c est le plus long de tous en Mobile Money : il dure
   * de quelques secondes a plusieurs minutes. Sans lui, l ecran ne pouvait
   * dire que « en attente », sans preciser que la balle est dans le camp du
   * client — qui attendait donc que KOLI fasse quelque chose.
   */
  AWAITING_CUSTOMER

  SUCCEEDED
  FAILED

  /**
   * La fenetre de validation s est refermee sans reponse.
   *
   * Distinct de FAILED : rien n a ete refuse, personne n a rien decide. Le
   * client peut simplement recommencer, et le message doit le dire.
   */
  EXPIRED
}

enum PaymentProviderType {
  TEST

  /// iKeePay, agregateur Mobile Money (phase 30).
  ///
  /// Cette valeur manquait, et rien ne le signalait tant que le mode reel
  /// n'avait jamais tourne : `lib/orders/actions.ts` ecrivait TEST en dur.
  /// Une commande payee par iKeePay aurait donc porte la mention TEST dans
  /// le registre — sur un journal financier, c'est un mensonge, et c'est
  /// precisement la colonne qu'on lit pour rapprocher nos ecritures de leur
  /// releve.
  IKEEPAY
}

enum TransactionType {
  PAYMENT
  COMMISSION
  FUNDS_SECURED
  FUNDS_RELEASED
  REFUND

  /// Frais de livraison acquis au livreur.
  ///
  /// Ils étaient encaissés du client — `Payment.amount` les comprend — mais
  /// n'étaient crédités à personne : ni au séquestre du vendeur, qui ne porte
  /// que la marchandise, ni à quiconque d'autre. Le livreur travaillait donc
  /// gratuitement dans le modèle.
  ///
  /// Écrite à la VALIDATION DE L'OTP, et non à la libération des fonds : c'est
  /// ce code qui prouve la remise, et le travail du livreur s'achève là. Le
  /// lier à la confirmation du client lui ferait porter un risque qui n'est
  /// pas le sien — un litige sur la marchandise oppose le client au vendeur et
  /// ne dit rien sur le fait que le colis a été remis.
  DRIVER_PAYOUT

  /// ⚠ IL N'Y A PAS DE `SELLER_PAYOUT` ICI, et c'est un choix.
  ///
  /// ┌────────────────────────────────────────────────────────────────────┐
  /// │  `Transaction.orderId` est OBLIGATOIRE. Un versement au vendeur    │
  /// │  n'appartient a aucune commande : il solde un cumul.               │
  /// └────────────────────────────────────────────────────────────────────┘
  ///
  /// L'y faire entrer aurait demande de rendre `orderId` nullable — donc de
  /// desserrer la contrainte qui garantit qu'aucune ligne du grand livre n'est
  /// orpheline, celle que `verif:schema` verifie. Echanger cette garantie
  /// contre une commodite d'ecriture serait un mauvais marche : une ligne
  /// financiere sans rattachement est pire qu'une ligne fausse, elle
  /// n'apparait plus nulle part.
  ///
  /// Le modele `Payout` EST le registre des versements, et
  /// `chargerSoldeVendeur` l'additionne directement.
}

enum DeliveryStatus {
  // Commande creee, aucun livreur encore designe. L'enum n'avait pas cet etat :
  // une livraison sans livreur etait marquee ASSIGNED, ce qui est faux (§26 —
  // l'assignation est un acte explicite du vendeur).
  UNASSIGNED
  ASSIGNED
  TO_PICK_UP
  PICKED_UP
  IN_TRANSIT
  ARRIVED
  TO_CONFIRM
  CONFIRMED
  FAILED
}

enum DisputeReason {
  NOT_RECEIVED
  WRONG_PRODUCT
  DAMAGED
  INCOMPLETE
  NOT_AS_DESCRIBED
  OTHER
}

enum DisputeStatus {
  OPEN
  ADMIN_REVIEW
  SELLER_WINS
  CUSTOMER_WINS
}

enum RefundStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum NotificationType {
  PAYMENT_CONFIRMED
  FUNDS_SECURED
  ORDER_ACCEPTED
  PACKAGE_READY
  PICKED_UP
  IN_TRANSIT
  // Le livreur est devant la porte. C est le moment ou le client doit AGIR :
  // sortir son code de reception. Sans type dedie, cet avis se serait confondu
  // avec « en route », qui n appelle aucun geste.
  ARRIVED
  DELIVERED
  CUSTOMER_CONFIRMED
  FUNDS_RELEASED
  DISPUTE_OPEN
  REFUND

  // ── Le VERSEMENT au vendeur (§43) ──
  //
  // Les deux seuls avis qui ne parlent pas d une commande : ils portent sur un
  // `Payout`, et leur `entityId` est donc l identifiant du versement, pas une
  // reference de commande.
  //
  // PAYOUT_REQUESTED part vers l ADMINISTRATION : sans lui, un vendeur peut
  // attendre son argent pendant qu une demande dort dans une file que personne
  // n a ouverte. C est la seule notification de KOLI adressee a l equipe.
  //
  // PAYOUT_PAID part vers le VENDEUR : c est l aboutissement de toute la
  // promesse, le moment ou l argent arrive vraiment.
  PAYOUT_REQUESTED
  PAYOUT_PAID
}

// ── Identité ────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  role         UserRole
  name         String
  phone        String     @unique
  email        String?    @unique

  /// Quand cette adresse a DEFINITIVEMENT refuse le courrier.
  ///
  /// ┌──────────────────────────────────────────────────────────────────────┐
  /// │  Ecrire a une adresse morte coute la reputation du domaine, donc la  │
  /// │  remise des courriels de TOUS les autres.                            │
  /// └──────────────────────────────────────────────────────────────────────┘
  ///
  /// Renseignee par le rappel de Resend, sur un rebond DUR ou une plainte
  /// pour pourriel. Un rebond passager — boite pleine, serveur indisponible —
  /// ne la renseigne pas : l adresse est bonne, c est le moment qui ne l est
  /// pas.
  ///
  /// Elle n efface pas l adresse : le compte garde son identifiant de
  /// connexion, et la personne peut la corriger depuis son profil.
  emailBouncedAt DateTime?

  /// Ce que le serveur d en face a repondu, mot pour mot.
  ///
  /// Sans lui, l ecran dirait « votre adresse ne recoit plus » sans pouvoir
  /// dire pourquoi — et personne ne saurait si c est une faute de frappe ou
  /// une boite fermee.
  emailBounceReason String?
  // Nullable : un compte cree via Google n'a pas de mot de passe. Le laisser
  // obligatoire aurait force a stocker un faux hachage, indistinguable d'un
  // vrai mot de passe pour le reste du code.
  passwordHash String?
  photoUrl     String?

  // Identifiant Google stable (claim `sub`). C'est LUI qui lie le compte, et
  // non l'e-mail : une adresse peut changer de proprietaire, `sub` non.
  googleId     String?     @unique
  status       UserStatus @default(ACTIVE)

  // Limitation des tentatives de connexion (§47). La contrainte existait pour
  // l'OTP mais pas pour le mot de passe : le compte acceptait un nombre
  // illimite d'essais.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Reinitialisation du mot de passe (§62). On stocke le HACHAGE du jeton, pas
  // le jeton : une fuite de la base ne doit pas permettre de prendre la main
  // sur les comptes dont une demande est en cours.
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sellerProfile   SellerProfile?
  customerProfile CustomerProfile?
  driverProfile   DriverProfile?
  notifications   Notification[]
  auditLogs       AuditLog[]       @relation("AuditActor")
  kycRevues       KycDocument[]    @relation("KycReviewer")
  historiques     OrderStatusHistory[] @relation("HistoriqueActeur")
  messagesLitige  DisputeMessage[]     @relation("MessageAuteur")
}

model SellerProfile {
  id                     String                   @id @default(cuid())
  userId                 String                   @unique
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName           String?
  verificationStatus     SellerVerificationStatus @default(PENDING)
  commissionRateOverride Float?

  // §37 : « Prevoir : identite, telephone, documents, statut. »
  //
  // Le nom LEGAL, tel qu il figure sur la piece — souvent different de
  // l enseigne commerciale. Sans lui, l administration compare le document a
  // un nom de boutique, ce qui ne prouve rien.
  //
  // Le telephone n est pas redouble ici : il vit deja sur le compte, et une
  // seconde copie divergerait a la premiere mise a jour.
  legalName              String?
  kycSubmittedAt         DateTime?

  /// Le pays du vendeur — donc SA DEVISE, donc celle de ses prix.
  ///
  /// Il manquait, et cela rendait un defaut d'argent inevitable : la devise
  /// d'une commande etait prise sur l'ACHETEUR alors que le prix est fixe par
  /// le VENDEUR. Un vendeur ivoirien vendant 2 000 XOF a un acheteur congolais
  /// encaissait 2 000 CDF — le quart de son du, sans que rien ne le signale.
  ///
  /// Nullable pour les comptes anterieurs, que rien ne peut renseigner
  /// retroactivement. `deviseDuVendeur` retombe alors sur XOF, et le DIT.
  country                String?

  /// La devise CHOISIE par le vendeur, quand il en a choisi une.
  ///
  /// ┌──────────────────────────────────────────────────────────────────────┐
  /// │  Nulle par defaut, et c est le point : on retombe alors sur celle    │
  /// │  du PAYS, exactement comme avant.                                    │
  /// └──────────────────────────────────────────────────────────────────────┘
  ///
  /// Les comptes crees avant ce champ gardent donc leur comportement, sans
  /// qu on ait a leur ecrire quoi que ce soit.
  ///
  /// Elle existe parce que le pays ne dit pas toujours la monnaie : a Kinshasa
  /// une part importante du commerce s affiche en dollars, et imposer le CDF a
  /// ce vendeur reviendrait a lui faire saisir des prix dans une monnaie qu il
  /// n utilise pas.
  ///
  /// ⚠ Elle ne relit RIEN. Les commandes figent leur devise a la creation, et
  /// les produits portent un entier : changer cette valeur apres coup
  /// reinterpreterait des prix deja saisis. La regle est ecrite dans
  /// `lib/sellers/devise.ts`.
  currency               String?

  createdAt              DateTime                 @default(now())

  products Product[]
  orders   Order[]
  kyc      KycDocument[]
  funds    Fund[]

  // §5.3 : « Au debut, chaque vendeur peut utiliser son propre livreur. »
  equipe       SellerDriver[]
  invitations  DriverInvite[]
  versements   Payout[]
  comptesRetrait PayoutAccount[]
}

/// Un numero Mobile Money ENREGISTRE par le vendeur pour ses retraits (§43).
///
/// ┌──────────────────────────────────────────────────────────────────────────┐
/// │  Demande de l'utilisateur, le 14 septembre 2026 : « qu'il ne puisse pas │
/// │  commencer a mettre les numeros a chaque fois qu'il a besoin            │
/// │  d'effectuer un retrait ».                                              │
/// └──────────────────────────────────────────────────────────────────────────┘
///
/// ⚠ Cela DEFAIT en partie une garde ecrite ici meme : le numero etait
/// redemande a chaque versement pour qu'un transfert ne parte jamais vers une
/// ligne resiliee sans que personne le voie. La protection est conservee
/// autrement — le vendeur ne SAISIT plus, mais il CHOISIT, et l'ecran lui
/// montre le numero complet et le nom du titulaire avant qu'il valide. Ce qui
/// est interdit, c'est le pre-remplissage silencieux.
///
/// `holderName` n'est pas decoratif : chez la plupart des operateurs, un
/// transfert arrive a un numero mais s'affiche sous le nom du titulaire. C'est
/// ce que l'administration compare avant d'envoyer, et c'est ce qui rattrape un
/// chiffre inverse.
model PayoutAccount {
  id       String        @id @default(cuid())
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  /// Le numero Mobile Money, tel que le vendeur l'a saisi.
  phone      String
  /// L'operateur, choisi dans la liste de son pays — « Wave », « Orange Money »…
  operator   String
  /// Le nom EXACT du titulaire du compte Mobile Money.
  holderName String
  /// Un surnom libre : « mon numero perso », « le compte de la boutique ».
  label      String?

  /// Le compte propose en premier. Un seul par vendeur — l'action le garantit.
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
}

/// Un VERSEMENT au vendeur (§43) — l'argent qui quitte KOLI.
///
/// ┌──────────────────────────────────────────────────────────────────────────┐
/// │  C'est le seul endroit du schema ou de l'argent SORT. Tout le reste     │
/// │  deplace des soldes a l'interieur de la plateforme.                     │
/// └──────────────────────────────────────────────────────────────────────────┘
///
/// Le vendeur demande, l'administration execute. Deux temps, et c'est
/// volontaire : iKeePay documente un point d'entree `h2h-payout`, mais il n'a
/// JAMAIS ete appele. Un versement execute a la main ne peut rien perdre a une
/// API non eprouvee, et avec quelques vendeurs c'est trivial. L'appel
/// automatique se branchera derriere la meme abstraction que l'encaissement,
/// une fois `h2h-payout` exerce pour de vrai.
model Payout {
  id       String        @id @default(cuid())
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  /// Le montant demande, en entier, dans la devise ci-dessous.
  amount   Int
  /// La devise du VERSEMENT, figee a la demande.
  ///
  /// Recopiee depuis le vendeur et jamais relue : un vendeur qui changerait de
  /// monnaie ne doit pas voir ses versements passes se reinterpreter. C'est la
  /// meme regle que `Transaction.currency`.
  ///
  /// ⚠ XOF et XAF s'affichent tous deux « FCFA » et valent exactement la meme
  /// chose, mais ne sont PAS interchangeables : on ne regle pas un vendeur
  /// camerounais avec des francs CFA d'Afrique de l'Ouest.
  currency String

  /// Le numero Mobile Money OU l'argent doit arriver.
  ///
  /// Demande a chaque versement plutot que lu sur le compte : c'est la seule
  /// donnee de la demande qui decide de la DESTINATION de l'argent, et un
  /// numero change — on en change meme souvent, sur ce marche. Le figer au
  /// compte ferait partir un versement vers une ligne resiliee, sans que
  /// personne ne s'en apercoive avant la reclamation.
  ///
  /// ⚠ Depuis le 14 septembre 2026, il est CHOISI parmi les comptes enregistres
  /// du vendeur (`PayoutAccount`) plutot que retape — mais il reste RECOPIE
  /// ici, jamais reference. Un vendeur qui corrige son numero apres coup ne
  /// doit pas changer la destination d'un versement deja demande : on relirait
  /// alors l'histoire, et le registre dirait qu'on a paye ailleurs.
  phone    String
  /// L'operateur, tel que le vendeur le nomme — Wave, Orange Money, MTN…
  operator String?
  /// Le nom du titulaire du compte Mobile Money, recopie du compte choisi.
  ///
  /// C'est ce que l'administration compare a ce qu'affiche l'application de
  /// transfert avant d'envoyer : un chiffre inverse donne un numero valide, et
  /// seul le nom le trahit. Nul pour les versements demandes avant l'existence
  /// des comptes enregistres.
  holderName String?

  status      PayoutStatus @default(PENDING)
  /// La reference du transfert chez le prestataire, ou le mode de reglement
  /// quand il a ete fait a la main. C'est ce qui permet de rapprocher.
  providerRef String?
  /// Pourquoi un versement a ete refuse. Un refus sans motif est
  /// incomprehensible pour celui qui le recoit.
  reason      String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  /// QUI a execute. Recopie en clair — le nom survit a la suppression du
  /// compte administrateur, comme dans le journal d'audit (§48).
  processedBy String?

  @@index([sellerId, status])
  @@index([status, requestedAt])
}

enum PayoutStatus {
  PENDING
  PAID
  REJECTED
}

model CustomerProfile {
  id      String  @id @default(cuid())
  userId  String  @unique
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  address String?
  city    String?
  country String?

  orders Order[]
}

model DriverProfile {
  id      String  @id @default(cuid())
  userId  String  @unique
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle String?

  // Ou il tourne, et s il prend des courses en ce moment (§26).
  //
  // `zone` est du TEXTE LIBRE — « Yopougon », « Cocody et Plateau ». Pas une
  // liste fermee de quartiers : personne ne tiendra a jour le decoupage
  // d Abidjan, et une liste incomplete oblige le livreur a mentir sur ou il
  // travaille. Le vendeur connait ses livreurs, il lit la phrase.
  //
  // Ce n est PAS de la geolocalisation. Le vendeur choisit lui-meme, en
  // lisant ; rien ici ne calcule un trajet ni ne classe par distance.
  zone      String?
  available Boolean @default(true)

  deliveries Delivery[]
  vendeurs   SellerDriver[]
}

// ── Equipes de livraison ────────────────────────────────
//
// §5.3 : « Au debut, chaque vendeur peut utiliser son propre livreur. »
//
// Avant cette table, `listAvailableDriversAction` renvoyait TOUS les livreurs
// actifs de la plateforme : n importe quel vendeur pouvait assigner le livreur
// d un concurrent, et voyait son nom. C etait une faille de cloisonnement
// autant qu une erreur de conception.

/**
 * Le lien entre un vendeur et un livreur — une table de jonction, PAS un
 * `sellerId` pose sur le livreur.
 *
 * Un livreur a moto d Abidjan travaille pour plusieurs commercants, et c est la
 * norme, pas l exception. Un rattachement unique l aurait oblige a ouvrir un
 * compte par vendeur — donc a jongler avec plusieurs numeros de telephone, et a
 * perdre son historique a chaque fois.
 */
model SellerDriver {
  id       String        @id @default(cuid())
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  driverId String
  driver   DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  // Par quelle invitation il est entre. `SetNull` et non `Cascade` : revoquer
  // une invitation ne doit PAS renvoyer les livreurs qu elle a fait entrer.
  inviteId String?
  invite   DriverInvite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // Deux fois le meme livreur dans la meme equipe n aurait aucun sens, et
  // ferait apparaitre son nom en double dans la liste d assignation.
  @@unique([sellerId, driverId])
  @@index([driverId])
}

/**
 * Le lien d invitation qu un vendeur remet a ses livreurs.
 *
 * Le livreur ouvre le lien, cree son compte, et se retrouve dans l equipe sans
 * que le vendeur ait rien a saisir. C est la seule facon d entrer dans une
 * equipe : il n existe pas de « chercher un livreur par son numero », qui
 * exposerait l annuaire des livreurs a qui devine un numero.
 *
 * REUTILISABLE et non a usage unique : un vendeur donne le meme lien a ses
 * quatre livreurs. D ou les trois garde-fous — jeton imprevisible, echeance,
 * revocation — puisque quiconque obtient le lien peut rejoindre l equipe. La
 * consequence reste mesuree : un nom de plus dans une liste, que le vendeur ne
 * choisit pas et peut retirer.
 */
model DriverInvite {
  id       String        @id @default(cuid())
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  // 32 octets tires au sort, en base64url. Pas un cuid : un identifiant de
  // base de donnees se devine parfois, et celui-ci vaut droit d entree.
  token String @unique

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  liens SellerDriver[]

  @@index([sellerId])
}

// ── Catalogue ───────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  category    String?
  price       Int      // FCFA — entier, pas de centimes
  quantity    Int      @default(0)
  weightKg    Float?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())

  images     ProductImage[]
  orderItems OrderItem[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int     @default(0)
}

// ── Commandes ───────────────────────────────────────────

model Order {
  id         String   @id @default(cuid())
  reference  String   @unique // "KOLI-000124"
  sellerId   String
  seller     SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  customerId String?
  customer   CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  buyerName     String
  buyerPhone    String
  // Etape 2 du formulaire de commande : e-mail facultatif du client. Servira a
  // lui transmettre la facture ; le telephone reste l'identifiant, l'e-mail
  // n'etant pas repandu dans le public vise.
  buyerEmail    String?
  buyerCountry  String
  buyerCity     String
  buyerAddress  String
  buyerLandmark String?

  deliveryFee Int         @default(0)
  // Zone monetaire de la commande : "XOF" (UEMOA) ou "XAF" (CEMAC, dont le
  // Cameroun). Les deux s'affichent « FCFA » mais ne sont pas interchangeables ;
  // sans ce champ, toute commande camerounaise etait traitee comme XOF.
  currency    String      @default("XOF")
  status      OrderStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  payment       Payment?
  delivery      Delivery?
  dispute       Dispute?
  refund        Refund?
  transactions  Transaction[]
  invoice       Invoice?
  statusHistory OrderStatusHistory[]
  fund          Fund?
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  unitPrice Int
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  /**
   * Qui a provoque le changement d etat.
   *
   * `SetNull` et non `Cascade` : supprimer un compte ne doit pas effacer
   * l historique d une commande. La ligne reste, elle perd seulement son
   * auteur — un trou dans l attribution vaut mieux qu un trou dans le
   * deroule des faits.
   *
   * Nul aussi quand l acte n a pas d auteur humain : un paiement aboutit sans
   * que personne ne clique cote KOLI.
   */
  actorUserId String?
  actor       User?        @relation("HistoriqueActeur", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt   DateTime     @default(now())

  @@index([orderId, createdAt])
}

// ── Paiement / argent (mode test) ──────────────────────

model Payment {
  id               String              @id @default(cuid())
  orderId          String              @unique
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider         PaymentProviderType @default(TEST)
  status           PaymentStatus       @default(PENDING)
  amount           Int
  simulatedOutcome String?             // "SUCCESS" | "FAILURE", mode test uniquement

  /**
   * Reference de la transaction CHEZ LE FOURNISSEUR.
   *
   * Elle etait produite par l abstraction et jetee aussitot : rien ne la
   * stockait. Un rappel asynchrone du prestataire — le mode normal en Mobile
   * Money — n avait donc aucun moyen de retrouver le paiement concerne.
   *
   * Unique : deux paiements ne peuvent pas revendiquer la meme transaction.
   */
  providerRef      String?             @unique

  /**
   * Clef d idempotence envoyee AU fournisseur.
   *
   * Les agregateurs l exigent : sans elle, un renvoi de requete apres une
   * coupure reseau cree un SECOND prelevement. Elle est fixee a la creation de
   * l intention et ne change jamais, meme sur reessai.
   */
  idempotencyKey   String?             @unique

  // Qui a paye, et depuis quel operateur. Necessaire au rapprochement et au
  // support : « je vous ai envoye l argent » se verifie avec ces deux champs.
  /// Ce que le prestataire a REELLEMENT encaisse, et dans quelle monnaie.
  ///
  /// `amount` est le montant de NOTRE commande — 200 XOF. iKeePay a preleve
  /// 796 CDF, sa propre conversion. Les deux sont vrais, et aucun des deux
  /// ne remplace l autre : le premier est ce que le vendeur recevra, le
  /// second ce qui a quitte le compte de l acheteur.
  ///
  /// Sans ces colonnes, le second chiffre n existait nulle part. Rapprocher
  /// notre registre du releve du prestataire etait donc impossible — et
  /// c est precisement ce qu on fait quand un paiement se perd.
  collectedAmount   Int?
  collectedCurrency String?

  payerMsisdn      String?
  payerOperator    String?

  /** Motif d echec en clair, pour l afficher au client sans le traduire. */
  failureReason    String?

  /**
   * Fin de la fenetre de validation. Au-dela, le paiement est EXPIRED.
   *
   * Sans echeance, un paiement jamais valide resterait « en attente » a vie et
   * immobiliserait la commande.
   */
  expiresAt        DateTime?

  /** Dernier rapprochement. Voir lib/payments/rapprochement.ts. */
  lastCheckedAt    DateTime?

  createdAt        DateTime            @default(now())
  confirmedAt      DateTime?

  @@index([status, expiresAt])
  @@index([status, lastCheckedAt])
}

model Transaction {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      TransactionType
  amount    Int             // signé : + crédit / - débit
  createdAt DateTime        @default(now())

  /// La monnaie de cette écriture.
  ///
  /// Recopiée depuis la commande, et c'est délibéré : une écriture de grand
  /// livre doit porter sa propre unité. La lire par jointure obligeait à
  /// remonter à `Order` pour savoir ce que « 2 000 » veut dire, et rendait
  /// impossible tout regroupement — `groupBy` ne sait pas sommer un montant
  /// en le classant par une colonne d'une autre table.
  ///
  /// Elle est FIGÉE, comme `rate` juste en dessous et pour la même raison : un
  /// vendeur qui change de pays ne doit pas voir la monnaie de ses écritures
  /// passées changer sous lui. Un journal comptable ne se relit pas à la
  /// lumière des réglages du jour.
  /// Pas de valeur par defaut, une fois les lignes existantes reprises.
  ///
  /// Un defaut « XOF » conviendrait aux donnees d aujourd hui et serait faux
  /// des la premiere ecriture congolaise — sans qu aucune erreur ne se
  /// produise nulle part. En le retirant, le compilateur EXIGE la devise a
  /// chaque creation d ecriture : six sites aujourd hui, et tous ceux qu on
  /// ajoutera.
  currency  String

  @@index([type, currency])

  // Taux appliqué, figé au moment de l'écriture (§41). Ne concerne que les
  // lignes COMMISSION ; ailleurs il reste nul.
  //
  // Il est stocké et non relu depuis `Commission` : le taux est configurable,
  // donc il change. Le relire aujourd'hui pour expliquer une écriture d'il y a
  // trois mois réécrirait le passé — un journal comptable ne se relit pas à la
  // lumière des réglages du jour.
  rate      Float?

  @@index([orderId])
  @@index([type, createdAt])
}

model Fund {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /**
   * Vendeur bénéficiaire.
   *
   * C'était le SEUL lien du schéma sans clé étrangère : `sellerId` n'était
   * qu'une chaîne. Rien n'empêchait donc d'y écrire un identifiant qui
   * n'existe pas — et le séquestre correspondant serait devenu invisible dans
   * le solde du vendeur, sans qu'aucune erreur ne le signale. Sur un registre
   * qui dit combien la plateforme doit à qui, c'est le genre d'écart qu'on ne
   * découvre qu'au moment de payer.
   *
   * `Cascade` par cohérence avec `Order.sellerId`, déjà en cascade : supprimer
   * un vendeur supprime déjà ses commandes, donc ses fonds par `orderId`. Un
   * autre choix ici produirait deux comportements contradictoires selon le
   * chemin de suppression.
   */
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  amount     Int
  secured    Boolean   @default(false)
  released   Boolean   @default(false)
  securedAt  DateTime?
  releasedAt DateTime?

  // Le solde vendeur agrège sur ces trois colonnes à chaque affichage.
  @@index([sellerId, secured, released])
}

model Refund {
  id          String       @id @default(cuid())
  orderId     String       @unique
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Int
  status      RefundStatus @default(PENDING)
  reason      String?
  createdAt   DateTime     @default(now())
  processedAt DateTime?
}

model Invoice {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  number    String   @unique
  createdAt DateTime @default(now())
}

model Commission {
  id          String   @id @default(cuid())
  ratePercent Float    @default(5)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ── Livraison ───────────────────────────────────────────

model Delivery {
  id          String         @id @default(cuid())
  orderId     String         @unique
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverId    String?
  driver      DriverProfile? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  status      DeliveryStatus @default(ASSIGNED)
  assignedAt  DateTime       @default(now())
  pickedUpAt  DateTime?
  arrivedAt   DateTime?
  deliveredAt DateTime?

  proof    DeliveryProof?
  otpCodes OtpCode[]
}

model DeliveryProof {
  id           String   @id @default(cuid())
  deliveryId   String   @unique
  delivery     Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  otpCode      String
  confirmedAt  DateTime @default(now())
  signatureUrl String?
  photoUrl     String?
  latitude     Float?
  longitude    Float?
}

model OtpCode {
  id          String    @id @default(cuid())
  deliveryId  String
  delivery    Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  code        String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
}

// ── Litiges ─────────────────────────────────────────────

model Dispute {
  id          String        @id @default(cuid())
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason      DisputeReason
  description String?
  status      DisputeStatus @default(OPEN)
  decision    String?
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?

  messages DisputeMessage[]
}

model DisputeMessage {
  id            String   @id @default(cuid())
  disputeId     String
  dispute       Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  /**
   * Auteur du message — client, vendeur ou administration.
   *
   * `Cascade` : les messages d un compte supprime partent avec lui. Un fil de
   * litige n a pas vocation a conserver les propos de quelqu un qui n existe
   * plus, et la decision, elle, reste au journal d audit.
   */
  authorUserId  String
  author        User     @relation("MessageAuteur", fields: [authorUserId], references: [id], onDelete: Cascade)

  body          String?
  attachmentUrl String?
  createdAt     DateTime @default(now())

  @@index([disputeId, createdAt])
}

// ── Notifications / audit / conformité ─────────────────

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  readAt     DateTime?
  entityType String?
  entityId   String?
  createdAt  DateTime         @default(now())

  /// Quand la notification a ete EXPEDIEE hors de l application.
  ///
  /// Nulle tant qu elle n existe que dans l ecran des notifications. Un
  /// vendeur qui ne rouvre pas KOLI de la journee ne sait pas qu il a vendu :
  /// c est le §44, et c est le moment le plus important a annoncer.
  ///
  /// Cette colonne est ce qui rend l envoi REPRENABLE. Sans elle, un incident
  /// au milieu d une fournee laisserait un doute — a-t-on deja ecrit a
  /// celui-ci ? — et le choix entre ne rien envoyer ou tout envoyer deux fois.
  sentAt     DateTime?

  /// Pourquoi l expedition a echoue, quand elle a echoue.
  ///
  /// Une adresse invalide, un refus du prestataire, une coupure. Sans ce
  /// champ, une notification jamais partie ressemble a une notification pas
  /// encore partie — et on la reessaie indefiniment sans savoir pourquoi.
  sendError  String?

  /// L identifiant que Resend rend a l envoi.
  ///
  /// Sans lui, un rappel de rebond arrive avec un identifiant qui ne
  /// correspond a rien chez nous : on apprend qu UN courriel a rebondi sans
  /// savoir lequel, ni pour quelle vente, ni chez qui.
  ///
  /// Il etait simplement jete — la reponse de l envoi n etait meme pas lue.
  providerMessageId String? @unique

  /// Quand le prestataire a confirme la REMISE.
  ///
  /// `sentAt` dit « nous avons confie le message », pas « il est arrive ».
  /// Un 200 de Resend veut dire ACCEPTE : le rebond, lui, se produit apres,
  /// et n arrive que par leur rappel. Les deux dates sont vraies et ne se
  /// remplacent pas.
  deliveredAt DateTime?

  /// Combien de fois on a DEJA essaye d expedier cette ligne.
  ///
  /// Sans ce compteur, un echec restait `sentAt = null` et repassait a chaque
  /// tour — indefiniment. La requete lit les 25 plus anciennes : vingt-cinq
  /// lignes definitivement en echec occupaient donc toute la fournee, et plus
  /// aucune vente n etait annoncee. Sans erreur, sans ecran, sans rien.
  ///
  /// Eprouve le 7 septembre 2026 avec une clef invalide : les deux memes
  /// lignes revenaient a chaque passage, « echouees=2 » trois fois de suite.
  sendAttempts Int @default(0)

  /// Les notifications a expedier se lisent par cet index, jamais par un
  /// balayage : la table grandit d une ligne par evenement et par destinataire.
  ///
  /// `sendAttempts` vient EN TETE : une ligne qui a deja echoue passe apres
  /// celles qui n ont jamais ete tentees. Une panne passagere ne doit pas
  /// retarder l annonce des ventes qui arrivent pendant qu elle dure.
  @@index([sentAt, sendAttempts, createdAt])

  // Le compteur de non-lues est lu à chaque affichage de page, sur toutes les
  // pages de l'espace connecté : sans index, c'est un balayage complet de la
  // table à chaque navigation.
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String   // ex. "FUNDS_RELEASE_TEST"
  entityType  String
  entityId    String
  metadata    String?  // JSON sérialisé

  // Copie du nom et du rôle de l'acteur au moment des faits.
  //
  // `actorUserId` est en `SetNull` : supprimer un compte ne doit pas effacer
  // ce qu'il a fait. Mais le lien se perd alors, et la ligne devient anonyme —
  // un journal qui ne peut plus nommer l'auteur d'une décision ne remplit plus
  // sa fonction. Ces deux champs, eux, survivent à la suppression du compte.
  actorName   String?
  actorRole   String?

  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([action])
}

model KycDocument {
  id       String        @id @default(cuid())
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type     String

  /**
   * Emplacement du fichier dans le magasin, JAMAIS une adresse publique.
   *
   * Une pièce d'identité déposée sous `/public` serait lisible par quiconque
   * devine son nom — et rien n'avertirait. Le fichier est écrit hors de
   * l'arborescence servie, et seul `/api/kyc/<id>` le restitue, après contrôle
   * du demandeur.
   */
  fileUrl  String

  /** Nom d'origine, pour l'affichage seulement — jamais pour écrire sur disque. */
  originalName String?
  /** Type déterminé par LECTURE du fichier, pas d'après ce que le client annonce. */
  mimeType     String?
  sizeBytes    Int?

  status KycStatus @default(PENDING)

  // Qui a décidé, quand, et pourquoi en cas de refus. Un rejet sans motif
  // laisse le vendeur sans rien à corriger.
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?     @relation("KycReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectionReason String?

  createdAt DateTime @default(now())

  @@index([sellerId, status])
  @@index([status, createdAt])
}

model Setting {
  key   String @id
  value String // JSON sérialisé
}
