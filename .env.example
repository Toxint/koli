# Base de données (Phase 2 — Base de données)
DATABASE_URL="file:./prisma/dev.db"

# Authentification — secret de signature des sessions JWT.
# 32 caractères minimum : l'application refuse de démarrer en dessous, il n'y a
# volontairement aucune valeur de repli (un secret codé en dur est un secret public).
# Générer le vôtre :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="remplacez-ceci-par-un-secret-genere-de-32-caracteres-minimum"

# Mode paiement — TEST tant que le partenaire financier n'est pas validé
# (voir docs/koli-plan.md §1, §84). Ne jamais passer à "real" sans validation.
PAYMENT_MODE="test"

# URL publique de l'application (liens de paiement, emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stockage des images (Phase 6+, pas encore utilisé)
# BLOB_READ_WRITE_TOKEN=""

# Emails transactionnels (Phase 25 — Notifications, pas encore utilisé)
# RESEND_API_KEY=""

# Connexion Google (OAuth 2.0). Facultatif : sans ces deux valeurs, le bouton
# « Continuer avec Google » ne s'affiche pas et le reste fonctionne normalement.
#
# Obtention — https://console.cloud.google.com/apis/credentials :
#   1. Créer un projet, puis « Écran de consentement OAuth » (externe).
#   2. « Créer des identifiants » > « ID client OAuth » > Application Web.
#   3. Origine JavaScript autorisée   : http://localhost:3000
#      URI de redirection autorisé    : http://localhost:3000/api/auth/google/callback
#
# ATTENTION — Google n'accepte comme adresse de rappel que `localhost`,
# `127.0.0.1` ou un domaine en HTTPS. Une IP de réseau local (192.168.x.x,
# 172.20.x.x) est REFUSÉE : la connexion Google ne fonctionnera donc pas depuis
# un téléphone sur le wifi tant qu'il n'y a pas de nom de domaine.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
